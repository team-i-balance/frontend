{
  "manifest_version": 3,
  "name": "AI 누리 보안",
  "version": "0.3.0",
  "description": "Claude(claude.ai)의 프롬프트를 입력 중 검사하고, 탐지된 단어를 칩으로 마스킹하거나 사유와 함께 원문을 유지합니다.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "action": { "default_popup": "connect.html", "default_title": "AI 누리 보안 연결" },
  "browser_specific_settings": {
    "gecko": {
      "id": "prompt-guard@ibalance.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["personallyIdentifyingInfo", "websiteContent"] }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["editor.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
